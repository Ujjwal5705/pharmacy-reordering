# Copy to .env with `npm run setup:env` (generates a fresh local encryption key).
# Never commit .env. Secrets below are intentionally left empty.

# --- Database (local Docker Compose container) ---
DATABASE_URL="postgresql://pharmacy:pharmacy_local_dev@localhost:5433/pharmacy?schema=public"
TEST_DATABASE_URL="postgresql://pharmacy:pharmacy_local_dev@localhost:5433/pharmacy_test?schema=public"

# --- App environment ---
# "demo" enables the fixed demo OTP and the synthetic-data banner. "production" forbids it.
APP_ENV="demo"
APP_BASE_URL="http://localhost:3000"

# --- Auth ---
# Fixed OTP accepted only when APP_ENV=demo. Ignored (and rejected at startup) otherwise.
AUTH_DEMO_OTP=""
SESSION_TTL_HOURS="12"

# --- Prescription storage (AES-256-GCM, base64 encoded 32-byte key) ---
PRESCRIPTION_ENCRYPTION_KEY=""
PRESCRIPTION_ENCRYPTION_KEY_ID="local-1"
PRIVATE_STORAGE_DIR="./storage/private"
UPLOAD_MAX_BYTES="8388608"

# --- Prescription extraction ---
# local-ocr  : Tesseract running inside this server; prescription never leaves the machine (default)
# anthropic  : Claude vision API; requires the two variables below AND explicit opt-in
# fixture    : deterministic synthetic-fixture provider used by automated tests
# none       : skip extraction; every prescription goes to manual pharmacist review
EXTRACTION_PROVIDER="local-ocr"
EXTRACTION_TIMEOUT_MS="25000"
EXTRACTION_MIN_FIELD_CONFIDENCE="0.80"
EXTRACTION_MIN_OVERALL_CONFIDENCE="0.75"
EXTRACTION_MIN_MATCH_SCORE="0.85"
ALLOW_EXTERNAL_PRESCRIPTION_PROCESSING="false"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# --- Refill reminders ---
REFILL_REMIND_DAYS_BEFORE="5"
